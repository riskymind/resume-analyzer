# Backend configuration. Copy to backend/.env for local development.
# Every variable is optional locally except GEMINI_API_KEY (needed for AI features).
# In production (APP_ENV=production) the app refuses to start unless
# GEMINI_API_KEY is set and DATABASE_URL points to PostgreSQL.

# --- Application -----------------------------------------------------------
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# json | text (default: text in development, json in production)
# LOG_FORMAT=text
# Comma-separated public frontend origin(s). Used for CORS AND for the CSRF
# origin check on state-changing requests, so it must list the origin users
# browse (e.g. https://your-app.vercel.app). HTTPS-only in production.
CORS_ORIGINS=http://localhost:5173
# Shared secret between the frontend proxy (Vercel) and the API. When set, every request except the
# liveness probe /api/v1/health must carry it in the X-Backend-Access-Key header (403 otherwise), so the
# API cannot be called directly, bypassing the proxy.
# REQUIRED with APP_ENV=production (the API refuses to start without it; at least 32 characters).
# Production value: generated by Render (render.yaml), copied into Vercel as a server-only variable.
# Leave unset for local development, Docker Compose and tests (the check is then disabled).
# BACKEND_ACCESS_KEY=

# --- Database --------------------------------------------------------------
# Default: SQLite at backend/data/resume_analyzer.db
# Production example: postgresql://user:password@host:5432/resume_analyzer
# DATABASE_URL=sqlite:///./data/resume_analyzer.db
# Run migrations automatically at startup (default: true except in production). In production run
# `python -m app.cli migrate` deliberately (Render: preDeployCommand; Compose: the `migrate` service).
# AUTO_MIGRATE=true

# --- AI provider (server-side only; never exposed to the browser) ----------
AI_PROVIDER=gemini
# Kill switch: false makes no AI calls at all (AI routes answer 503) even when a key is set.
AI_CALLS_ENABLED=true
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.6-flash
# Per-attempt timeout, retries on 408/429/5xx/network errors, and one overall
# deadline for a whole AI call (attempts + back-off). Keep the deadline below
# your proxy/platform request timeout.
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_TOTAL_TIMEOUT_SECONDS=90
# Semantic skill matching for job matches (embeddings). If disabled or the call
# fails, matching falls back to deterministic keyword/lexicon matching and the
# report says so. Changing the model or dimensions invalidates cached vectors.
SEMANTIC_MATCHING_ENABLED=true
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Upper bound on texts (skill names + resume bullets) embedded per match
EMBEDDING_MAX_TEXTS=150

# --- Uploads ---------------------------------------------------------------
# Per-file limit (bytes) and whole-request limit (bytes)
MAX_UPLOAD_BYTES=5242880
MAX_REQUEST_BYTES=12582912
MAX_PDF_PAGES=20
# Resumes with more extracted text than this are rejected
MAX_RESUME_CHARS=40000
# PDFs with fewer letters/digits than this (or 20 per page) are treated as scans
MIN_PDF_TEXT_CHARS=40
# Job descriptions: maximum characters, and minimum letters/digits for /api/v1/jobs
MAX_JOB_DESCRIPTION_CHARS=30000
MIN_JOB_DESCRIPTION_CHARS=30

# --- Authentication / sessions (see docs/auth.md) -------------------------
SESSION_TTL_HOURS=168
SESSION_IDLE_TIMEOUT_HOURS=24
# Secure (HTTPS-only, __Host- prefixed) cookies. Default: on in production
# (cannot be disabled there), off locally so plain-HTTP localhost works.
# COOKIE_SECURE=false
# Argon2id cost (defaults follow RFC 9106; raise, never lower, in production)
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_MEMORY_KIB=65536
PASSWORD_HASH_PARALLELISM=4

# --- Rate limits (stored in the database; shared by all workers/instances) -
LOGIN_MAX_ATTEMPTS_PER_IP=20        # per 15 minutes
LOGIN_MAX_ATTEMPTS_PER_EMAIL=10     # per 15 minutes
REGISTER_MAX_PER_IP=5               # per hour
AI_MAX_REQUESTS_PER_MINUTE=5        # per user
AI_MAX_REQUESTS_PER_DAY=50          # per user
EXPORT_MAX_PER_MINUTE=10            # PDF/DOCX exports per user (rewrite generation uses the AI limits above)

# --- Resume rewriting (see docs/rewriting.md) ------------------------------
# Saved versions kept per rewrite; older ones are pruned (the first generation is always kept)
REWRITE_MAX_VERSIONS=30

# --- Container only (backend/docker-entrypoint.sh; ignored by `uvicorn` run by hand) ------------------
# PORT=8000                        # Render injects this
# WEB_CONCURRENCY=1                # uvicorn worker processes
# FORWARDED_ALLOW_IPS=127.0.0.1    # proxies trusted for X-Forwarded-*; '*' behind Render or the Compose nginx
# RUN_MIGRATIONS_ON_START=false    # "true" migrates (advisory-locked) before serving, for hosts without a pre-deploy step
# GRACEFUL_SHUTDOWN_SECONDS=25     # time in-flight requests get after SIGTERM
