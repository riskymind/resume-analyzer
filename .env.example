# Docker Compose settings. Copy to `.env` in the repository root (it is git-ignored) and fill in the values.
#   cp .env.example .env
# Compose reads this file for ${VARIABLE} substitution in compose*.yaml. Nothing here reaches the browser.
# The full list of backend settings (limits, timeouts, Argon2, rate limits) is in backend/.env.example; the
# Compose files pass only what the stack needs. Production (Render/Vercel) variables: docs/deploy-render.md and
# docs/deploy-vercel.md.

# --- Required ------------------------------------------------------------------------------------------------
# Password of the local PostgreSQL role. Use letters and digits only (it is embedded in a URL), e.g.
#   openssl rand -hex 16
POSTGRES_PASSWORD=

# --- Optional ------------------------------------------------------------------------------------------------
# Server-side only. Leave blank to run without AI: everything else works and AI features answer
# "AI analysis is not configured". Setting it makes real, billable Gemini calls from the local stack.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# PostgreSQL role and database (created on first start; changing them later needs `docker compose down --volumes`)
# POSTGRES_USER=resume
# POSTGRES_DB=resume_analyzer

# Host ports (all bound to 127.0.0.1)
# WEB_PORT=8080            # production-like stack (nginx)
# DEV_WEB_PORT=5173        # compose.dev.yaml: Vite dev server
# API_PORT=8000            # compose.dev.yaml: API
# DB_PORT=5433             # compose.dev.yaml: PostgreSQL (5433 avoids a local PostgreSQL on 5432)
# FAKE_AI_WEB_PORT=8090    # compose.fake-ai.yaml

# API processes and logging
# WEB_CONCURRENCY=2
# LOG_LEVEL=INFO
