# Rendered at container start by the nginx image's envsubst step (only defined variables such as
# ${API_UPSTREAM} are substituted; nginx's own $variables are left alone).
#
# Same contract as the Vercel configuration (vercel.json): /api/* goes to the API, real files are served
# as-is, every other path gets index.html so client-side routes such as /rewrites/<id> survive a reload.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # The API accepts 12 MB request bodies (MAX_REQUEST_BYTES); allow a little framing overhead.
    client_max_body_size 13m;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API: never falls through to index.html, so API errors stay JSON.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        # Overwrite (not append): a client cannot smuggle a fake address past this proxy. The API trusts
        # X-Forwarded-For only because it is reachable solely through this proxy on the Compose network.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        # AI calls may take up to AI_TOTAL_TIMEOUT_SECONDS (90 s by default).
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Content-hashed build output: cache forever; a missing asset is a 404, not the HTML page.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # SPA fallback.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
}
